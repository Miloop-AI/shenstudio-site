      "includeFiles": "{src/**,fallback/**,assets/brand/logo_horizontal.png,assets/brand/logo_horizontal_white.png,assets/banners/hero_strip.jpg,assets/banners/hero_strip_mobile.jpg,assets/photos/host_about.jpg}"
    }
  }
}
